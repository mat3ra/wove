{
    "name": "@mat3ra/wove",
    "version": "0.0.0",
    "description": "Workflow Viewer components",
    "repository": {
        "type": "git",
        "url": "https://github.com/mat3ra/wove.git"
    },
    "bugs": {
        "url": "https://github.com/mat3ra/wove/issues"
    },
    "homepage": "https://github.com/mat3ra/wove",
    "main": "dist/exports.js",
    "types": "dist/exports.d.ts",
    "files": [
        "/dist",
        "/src",
        "tsconfig.json"
    ],
    "scripts": {
        "dev": "vite --port 3007",
        "build": "tsc && npm run copy-css",
        "build:standalone": "vite build",
        "copy-css": "mkdir -p dist/stylesheets && cp src/stylesheets/* dist/stylesheets/ 2>/dev/null || true",
        "transpile": "tsc",
        "test": "node --import tsx --test tests/*.tests.ts",
        "lint": "eslint src tests && prettier --check src tests",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@mat3ra/wode": "*",
        "d3-hierarchy": "^3.1.2",
        "reactflow": "^11.7.2",
        "underscore.string": "^3.3.4"
    },
    "peerDependencies": {
        "@mat3ra/cove": "*",
        "@mat3ra/ave": "*",
        "@mat3ra/code": "*",
        "@mat3ra/esse": "*",
        "@mat3ra/made": "*",
        "@mat3ra/mode": "*",
        "@mat3ra/move": "*",
        "@mat3ra/standata": "*",
        "react": "^17.0.0",
        "react-dom": "^17.0.0"
    },
    "peerDependenciesMeta": {
        "@mat3ra/ave": {
            "optional": true
        },
        "@mat3ra/move": {
            "optional": true
        }
    },
    "license": "Apache-2.0",
    "devDependencies": {
        "@emotion/babel-plugin": "^11.11.0",
        "@emotion/react": "^11.11.0",
        "@emotion/styled": "^11.11.0",
        "@mat3ra/cove": "2026.7.18-4",
        "@mat3ra/ade": "2026.5.29-0",
        "@mat3ra/code": "2026.5.27-0",
        "@mat3ra/esse": "2026.6.16-0",
        "@mat3ra/ide": "2026.5.28-0",
        "@mat3ra/made": "2026.7.8-0",
        "@mat3ra/mode": "2026.6.3-0",
        "@mat3ra/standata": "2026.6.12-1",
        "@mat3ra/tsconfig": "^2024.6.3-0",
        "@mat3ra/wode": "2026.7.9-0",
        "@mui/icons-material": "^5.11.9",
        "@mui/lab": "^5.0.0-alpha.120",
        "@mui/material": "^5.11.9",
        "@mui/styles": "^5.11.9",
        "@types/lodash": "^4.14.202",
        "@types/node": "^20.11.30",
        "@types/react": "^17.0.2",
        "@types/react-dom": "^17.0.2",
        "@vitejs/plugin-react": "^4.3.4",
        "lodash": "^4.17.4",
        "react": "^17.0.2",
        "react-dom": "^17.0.2",
        "tsx": "^4.22.4",
        "typescript": "^5.6.6",
        "underscore": "^1.8.3",
        "underscore.string": "^3.3.4",
        "vite": "^6.0.7",
        "vite-plugin-node-polyfills": "^0.25.0"
    }
}
